# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# ---- DEMO SETTINGS ----
# DEMO_MODE=true  -> paid events skip Razorpay, auto-confirm, show QR (no money)
DEMO_MODE=true
# MAIL_TRANSPORT: ethereal (fake inbox + preview URL) | smtp (real) | console (log only)
MAIL_TRANSPORT=ethereal

# Database
MONGO_URI=mongodb://127.0.0.1:27017/event_portal

# JWT
JWT_SECRET=change_this_to_a_long_random_secret
JWT_EXPIRES_IN=7d

# OTP (dev: printed to console; prod: wire SMS provider)
OTP_TTL_SECONDS=300
OTP_DEV_MODE=true

# Razorpay (only needed when DEMO_MODE=false; use rzp_test_ keys for sandbox)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=xxxxxxxx
RAZORPAY_WEBHOOK_SECRET=xxxxxxxx

# Email (only used when MAIL_TRANSPORT=smtp)
#
# --- SendGrid (recommended for demo: real mail to a real inbox) ---
#   1) Verify a Single Sender (Settings > Sender Authentication)
#   2) Create an API key (Settings > API Keys, Mail Send permission)
#   3) Set MAIL_TRANSPORT=smtp and the values below.
#   SMTP_USER must be the literal word "apikey".
#   SMTP_PASS is the SG.xxxx key.
#   MAIL_FROM email MUST equal the verified single sender.
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=SG.your_sendgrid_api_key_here
MAIL_FROM="Event Portal <your_verified_sender@gmail.com>"

# Admin bootstrap (email + password login)
ADMIN_EMAIL=admin@medevents.test
ADMIN_PASSWORD=admin123

# Upload
UPLOAD_DIR=uploads
MAX_PHOTO_MB=5
